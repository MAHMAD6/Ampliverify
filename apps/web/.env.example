# Base URL of the AmpliVerify API (apps/api), without the /api/v1 prefix.
API_URL=http://localhost:4000

# --- Better Auth (runs inside this app at /api/auth) ---
# Public origin of this web app. The API's BETTER_AUTH_JWKS_URL must be
# ${BETTER_AUTH_URL}/api/auth/jwks.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Must equal the API's BETTER_AUTH_ISSUER / BETTER_AUTH_AUDIENCE.
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=ampliverify-api
# Better Auth's own database (users' credentials and sessions), separate from
# the API database. Create it, then run `npm run auth:migrate`.
AUTH_DATABASE_URL=postgresql://ampliverify:local-dev-only@localhost:5432/ampliverify_auth
# Must equal the API's AUTH_SYNC_SECRET (server-to-server user provisioning).
AUTH_SYNC_SECRET=replace-with-at-least-32-random-characters

# Local development only: print verification / reset links to the server log
# (ignored unless BETTER_AUTH_URL is localhost). No email provider is wired yet.
# AUTH_EMAIL_LOG_LINKS=true

# Optional social sign-in. A provider's button is enabled only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
