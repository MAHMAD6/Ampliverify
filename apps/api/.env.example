NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ampliverify:local-dev-only@localhost:5432/ampliverify
# Separate database used by `npm run test:db` (it is reset by the tests).
TEST_DATABASE_URL=postgresql://ampliverify:local-dev-only@localhost:5432/ampliverify_test
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=ampliverify-api
AUTH_SYNC_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
STORAGE_DIR=./storage

# --- Web app origin (links in emails, OAuth redirects, Stripe return URLs) ---
WEB_URL=http://localhost:3000

# --- Background jobs (PostgreSQL queue). Set JOBS_WORKER=off to run API-only nodes. ---
JOBS_WORKER=on
JOBS_POLL_MS=2000

# --- File storage: local (STORAGE_DIR) or any S3-compatible bucket ---
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Email (Resend). EMAIL_LOG_ONLY=true prints emails to the log in development. ---
RESEND_API_KEY=
EMAIL_FROM=AmpliVerify <no-reply@ampliverify.com>
# EMAIL_LOG_ONLY=true

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI: Claude powers editor suggestions, content ideas/briefs and the Claude GEO platform ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- AI search (GEO) platforms; each is checked only when its key is set ---
OPENAI_API_KEY=
# OPENAI_GEO_MODEL=gpt-5
GEMINI_API_KEY=
# GEMINI_GEO_MODEL=gemini-2.5-flash
PERPLEXITY_API_KEY=
# PERPLEXITY_GEO_MODEL=sonar

# --- Keyword data (DataForSEO) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Integrations: encryption key for stored credentials (>= 32 chars) and Google OAuth ---
INTEGRATION_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Malware scanning for job-application uploads (ClamAV daemon) ---
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Local development only: allow audits/integrations to reach localhost and private IPs ---
# AUDIT_ALLOW_PRIVATE_HOSTS=true

# Proxies whose X-Forwarded-For is trusted for client IPs (rate limits on
# public forms). Express "trust proxy" syntax; default trusts private networks.
TRUST_PROXY=loopback, uniquelocal
