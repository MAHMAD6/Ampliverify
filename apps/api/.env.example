NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ampliverify:local-dev-only@localhost:5432/ampliverify
# Separate database used by `npm run test:db` (it is reset by the tests).
TEST_DATABASE_URL=postgresql://ampliverify:local-dev-only@localhost:5432/ampliverify_test
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=ampliverify-api
AUTH_SYNC_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
STORAGE_DIR=./storage

# --- Web app origin (links in emails, OAuth redirects, Stripe return URLs) ---
WEB_URL=http://localhost:3000

# --- Background jobs. PostgreSQL is the durable outbox; with REDIS_URL jobs are
# dispatched through a Redis (BullMQ) queue with a dead-letter queue, and request
# throttling counters are shared in Redis. Without it the API polls PostgreSQL.
# Set JOBS_WORKER=off to run API-only nodes. ---
# REDIS_URL=redis://localhost:6379
JOBS_WORKER=on
JOBS_POLL_MS=2000
# JOBS_CONCURRENCY=5

# --- File storage: private S3-compatible bucket in production (V1 manual); local
# STORAGE_DIR only for development. Report PDFs/CSVs are downloaded through
# short-lived signed URLs (S3_SIGNED_URL_SECONDS, default 300). ---
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=   # Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com with S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SIGNED_URL_SECONDS=300

# --- Email (Amazon SES v2). EMAIL_FROM must be a verified SES identity (configure
# SPF/DKIM DNS; mind the SES sandbox). Credentials: SES_ACCESS_KEY_ID /
# SES_SECRET_ACCESS_KEY or the default AWS credential chain.
# EMAIL_LOG_ONLY=true prints emails to the log in development. ---
SES_REGION=
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_CONFIGURATION_SET=
EMAIL_FROM=AmpliVerify <no-reply@ampliverify.com>
# EMAIL_LOG_ONLY=true

# --- Payments (Stripe) ---
# A restricted key (rk_...) works: grant Checkout Sessions, Customers, Customer portal,
# Prices (read), Subscriptions, Invoices (read) and Charges/Refunds (read). With a
# restricted key, create products/prices in the Stripe dashboard and link the price IDs
# in Super Admin -> Plans (and optionally per credit pack). Price IDs live in the
# database, not env vars. No publishable key is needed (hosted Checkout + Portal).
# Webhook events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, customer.subscription.created/updated/deleted,
# invoice.finalized/paid/payment_failed/voided/marked_uncollectible, charge.refunded,
# charge.dispute.created, refund.created, refund.updated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI (OpenAI Responses API with Structured Outputs): editor suggestions,
# content ideas and briefs. Use a restricted project key; pick a model the
# project supports. ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# --- DataForSEO: keyword data, website valuation search estimates and GEO
# observations (Google AI Mode + Google organic / AI Overview, Standard queued mode) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# DATAFORSEO_BASE_URL=https://api.dataforseo.com/v3

# --- Google (Google API Integration Manual V1.1). OAuth web client for Search Console
# and GA4 (read-only scopes, PKCE); the redirect URI must match the one registered on
# the client exactly. PageSpeed uses a server-side key restricted to the PageSpeed API.
# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET / PAGESPEED_API_KEY still work. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ampliverify.com/app/integrations/google/callback
GOOGLE_PAGESPEED_API_KEY=
# Optional separate key for Google tokens (>= 32 chars); defaults to INTEGRATION_ENCRYPTION_KEY.
# GOOGLE_TOKEN_ENCRYPTION_KEY=
# Days synced Google metrics are kept after a connection is disconnected (default 30).
# GOOGLE_DATA_RETENTION_DAYS=30

# --- Integrations: encryption key for stored credentials (>= 32 chars) ---
INTEGRATION_ENCRYPTION_KEY=

# --- Malware scanning for job-application uploads (ClamAV daemon) ---
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Local development only: allow audits/integrations to reach localhost and private IPs ---
# AUDIT_ALLOW_PRIVATE_HOSTS=true

# Proxies whose X-Forwarded-For is trusted for client IPs (rate limits on
# public forms). Express "trust proxy" syntax; default trusts private networks.
TRUST_PROXY=loopback, uniquelocal

# Authenticated requests per minute per user (anonymous: per IP). Public forms: 10/min.
RATE_LIMIT_PER_MINUTE=600

# Days a deleted project is kept (restorable by support) before it and its files are purged.
PROJECT_PURGE_GRACE_DAYS=30
