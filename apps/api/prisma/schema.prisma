  @@map("membership_status")
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED

  @@map("run_status")
}

/// Scheduled content = PUBLISHED with published_at in the future. Public routes
/// must filter status = PUBLISHED AND published_at <= now().
enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("publish_status")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
