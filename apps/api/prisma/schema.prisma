// AmpliVerify — PostgreSQL + Prisma schema (NestJS API)
//
// Source of truth: docs/AmpliVerify_Database_Architecture_Implementation_Guide.pdf
// (section 22 "Complete Table Catalog" / 22A "Table-by-Table Field Specification").
//
// Conventions (guide §2, §21):
//   * PascalCase models mapped to snake_case tables/columns with @@map / @map.
//   * UUID primary keys, timestamptz(6) timestamps in UTC.
//   * Money is integer minor units (BigInt); credits/units are Decimal(18,4).
//   * Financial, security and audit history uses onDelete: Restrict and is append-only.
//   * Tenant boundary is workspace_id; project-scoped data resolves project -> workspace.
//   * Secrets are never stored here — only *_ref pointers into secret/object storage.
//
// Things Prisma cannot express (partial indexes, append-only triggers, CHECK
// constraints) live in the hand-written SQL at the end of the initial migration.
// Additions beyond the guide's catalog are marked "ADDITION" with the reason.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// The guide fixes the first six; the remaining value sets are proposed here
// and should be confirmed with product before the first production migration.
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("workspace_status")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
