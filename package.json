{
  "name": "ampliverify",
  "private": true,
  "description": "AmpliVerify \u2014 Audit \u2022 Optimize \u2022 Verify. Multi-tenant SEO / AI-search SaaS.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "test": "npm run test --workspace apps/api",
    "test:db": "npm run test:db --workspace apps/api",
    "typecheck": "npm run typecheck --workspace apps/api && npm run typecheck --workspace apps/web",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:deploy": "npm run db:deploy --workspace apps/api",
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web"
  },
  "overrides": {
    "deepmerge-ts": "$deepmerge-ts",
    "body-parser": "^2.4.0",
    "multer": "2.5.0",
    "undici": "^7.30.1",
    "zod": "^4.6.7",
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  },
  "devDependencies": {
    "deepmerge-ts": "^8.0.2"
  }
}
